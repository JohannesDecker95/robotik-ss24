                "isDefault": true
            }
        },
        {
            "label": "Build ROS Package Solver",
            "type": "shell",
            "command": "colcon build --packages-select pkg_solver",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build ROS Package Visualizer",
            "type": "shell",
