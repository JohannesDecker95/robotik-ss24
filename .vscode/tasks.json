{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build ROS Package All",
            "type": "shell",
            "command": "colcon build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },         {
            "label": "Build ROS Package Digitalize",
            "type": "shell",
            "command": "colcon build --packages-select pkg_digitalize",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
